# {{ ansible_managed }}
# 401 (неверный Bearer-ключ LLM) и 404 в закрытых префиксах. Неизвестные пути получают лендинг (200),
# поэтому эти статусы видит только тот, кто уже знает секретный префикс; легитимные клиенты их не вызывают.
[Definition]
failregex = ^\{.*"remote_ip":"<HOST>".*"status":(?:401|404),
datepattern = "ts":{EPOCH}
