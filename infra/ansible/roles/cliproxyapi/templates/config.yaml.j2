# {{ ansible_managed }}
config-version: 8
server:
  host: "127.0.0.1"
  port: {{ cliproxyapi_port }}
  # Caddy приходит с 127.0.0.1: без этого внешние клиенты считались бы локальными (components/cliproxyapi.md)
  trusted-proxies: ["127.0.0.1"]
access:
  api-keys: {{ cliproxyapi_api_keys | to_json }}
management:
  # готовый bcrypt-хэш: приложение не может переписать read-only конфиг
  secret-key: {{ cliproxyapi_management_key_hash | to_json }}
  allow-remote: false
  disable-auto-update-panel: true
observability:
  usage:
    usage-statistics-enabled: true
oauth:
  auth-dir: "/var/lib/cliproxyapi/auth"
requests:
  proxy-url: {{ cliproxyapi_proxy_url | to_json }}
{% if cliproxyapi_openai_compatibility %}
openai-compatibility: {{ cliproxyapi_openai_compatibility | to_json }}
{% endif %}
