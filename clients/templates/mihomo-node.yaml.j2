# {{ ansible_managed }}
# Фрагмент для clash-verge-rev: вставить в proxies:. Содержит секрет (uuid, путь).
proxies:
  - name: "{{ inventory_hostname }}-{{ xray_transport }}"
    type: vless
    server: {{ domain }}
    port: 443
    uuid: {{ vless_users[0].id }}
{% if xray_transport == 'ws' %}
    network: ws
    tls: true
    udp: false
    servername: {{ domain }}
    alpn: [http/1.1]
    client-fingerprint: chrome
    ws-opts:
      path: /{{ ws_path }}
      headers: { Host: {{ domain }} }
{% elif xray_transport == 'xhttp' %}
    network: xhttp
    tls: true
    udp: false
    servername: {{ domain }}
    alpn: [h2, http/1.1]
    client-fingerprint: chrome
    xhttp-opts:
      path: /{{ ws_path }}
      mode: auto
{% endif %}
    ip-version: ipv4
